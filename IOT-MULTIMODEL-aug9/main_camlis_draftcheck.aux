\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces The \texttt  {Rate} feature (packets/sec, averaged per 30-row window) over the first 60 windows of the raw capture, for Benign traffic and four DDoS attack types. TCP, UDP, and SYN floods elevate Rate roughly one to two orders of magnitude above the benign baseline, which is exactly the signal a per-feature z-score or Isolation Forest threshold can exploit. DDoS-HTTP\_Flood and DDoS-SlowLoris, by contrast, have Rate values statistically indistinguishable from benign traffic --- both are low-and-slow, application-layer attacks.\relax }}{11}{figure.caption.11}\protected@file@percent }
\newlabel{fig:rate_comparison}{{4}{11}{The \code {Rate} feature (packets/sec, averaged per 30-row window) over the first 60 windows of the raw capture, for Benign traffic and four DDoS attack types. TCP, UDP, and SYN floods elevate Rate roughly one to two orders of magnitude above the benign baseline, which is exactly the signal a per-feature z-score or Isolation Forest threshold can exploit. DDoS-HTTP\_Flood and DDoS-SlowLoris, by contrast, have Rate values statistically indistinguishable from benign traffic --- both are low-and-slow, application-layer attacks.\relax }{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Baseline detector recall ($n{=}40$/class) vs.\ Claude naive-condition classification accuracy ($n{=}5$/class), by attack category. Both baselines are strong on volumetric Flood/Mirai traffic and collapse on Recon, Spoofing/MITM, Brute Force, and Web/App-layer attacks; the LLM remains near-ceiling across every category.\relax }}{12}{figure.caption.12}\protected@file@percent }
\newlabel{fig:baseline_vs_llm}{{5}{12}{Baseline detector recall ($n{=}40$/class) vs.\ Claude naive-condition classification accuracy ($n{=}5$/class), by attack category. Both baselines are strong on volumetric Flood/Mirai traffic and collapse on Recon, Spoofing/MITM, Brute Force, and Web/App-layer attacks; the LLM remains near-ceiling across every category.\relax }{figure.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Cross-model comparison. (a) Classification accuracy by condition. (b) Citation correctness among attack samples: both models improve substantially under RAG relative to their own ungrounded conditions, but GPT-4o's ungrounded correctness is roughly a third of Claude's while its RAG-grounded correctness exceeds Claude's.\relax }}{13}{figure.caption.14}\protected@file@percent }
\newlabel{fig:cross_model}{{6}{13}{Cross-model comparison. (a) Classification accuracy by condition. (b) Citation correctness among attack samples: both models improve substantially under RAG relative to their own ungrounded conditions, but GPT-4o's ungrounded correctness is roughly a third of Claude's while its RAG-grounded correctness exceeds Claude's.\relax }{figure.caption.14}{}}
